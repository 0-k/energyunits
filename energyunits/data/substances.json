{
  "_metadata": {
    "description": "Fuel and material properties used for substance-aware conversions.",
    "fields": {
      "hhv": "Higher heating value (gross calorific value) in MJ/kg",
      "lhv": "Lower heating value (net calorific value) in MJ/kg",
      "density": "Density in kg/m3 (bulk density for solids, normal conditions for gases)",
      "carbon_intensity": "Direct CO2 emission factor in kg CO2 per GJ (LHV basis). 0 for biogenic fuels by IPCC accounting convention",
      "carbon_content": "Carbon mass fraction (kg C per kg fuel), used for stoichiometric CO2",
      "hydrogen_content": "Hydrogen mass fraction (kg H per kg fuel), used for H2O",
      "ash_content": "Ash mass fraction (kg ash per kg fuel)",
      "biogenic": "True if the carbon is of biogenic origin (CO2 is physical, but usually reported as zero)",
      "moisture_content": "Moisture mass fraction of the as-received fuel (biomass)"
    },
    "consistency": "For fossil fuels, carbon_content = carbon_intensity * lhv / 1000 * 12/44, so that stoichiometric CO2 reproduces the IPCC 2006 default emission factors exactly.",
    "sources": "IPCC 2006 Guidelines Vol. 2 (Tables 1.2-1.4), IEA, EPA; see DATA_SOURCES.md"
  },
